POSTGRES_DB=rentcrm
POSTGRES_USER=rentcrm
POSTGRES_PASSWORD=replace-with-long-random-password
APP_JWT_SECRET=replace-with-at-least-32-random-characters
APP_CORS_ORIGINS=https://your-domain.ru
APP_AUTH_PUBLIC_BASE_URL=https://your-domain.ru
APP_AUTH_DEV_LINKS_ENABLED=false
APP_FIELD_ENCRYPTION_KEY=base64-encoded-32-byte-key
APP_BILLING_WEBHOOK_SECRET=replace-with-payment-webhook-secret
APP_ERROR_ALERT_EMAIL=ops@your-domain.ru
APP_DOCUMENT_STORAGE_DIR=/app/uploads/documents
APP_DOCUMENT_MAX_FILE_SIZE=30MB
APP_DOCUMENT_MAX_REQUEST_SIZE=31MB
APP_SERVICE_LOG_LEVEL=INFO
APP_BILLING_LOG_LEVEL=INFO
APP_NOTIFICATION_LOG_LEVEL=INFO
APP_MAIL_FROM=no-reply@your-domain.ru
SPRING_MAIL_HOST=smtp.your-provider.ru
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=smtp-user
SPRING_MAIL_PASSWORD=replace-with-smtp-password
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS=true
HTTP_PORT=80

# Postgres backup settings
# 86400 seconds = daily backups. Backup service keeps only the latest 2 dumps by default.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_LAST=2
BACKUP_RUN_ON_START=true
